version: 1
formatters:
  simple:
    format: '%(levelname)s %(name)s: %(message)s'
handlers:
  console:
    class: logging.StreamHandler
    formatter: simple
    stream: ext://sys.stdout
loggers:
  synapse.access:
    level: ERROR
root:
  level: WARNING
  handlers: [console]
disable_existing_loggers: false
